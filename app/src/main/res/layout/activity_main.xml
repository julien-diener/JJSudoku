<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#FAFAFA">

    <!-- Title + status row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sudoku"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#555555" />
    </LinearLayout>

    <!-- Board (square, fills available width) -->
    <org.jjgame.sudokuapp.SudokuBoardView
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:paddingTop="6dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnToggleEditCandidates"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Toggle candidate editing"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Digit pad: 1–9 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="9"
        android:paddingTop="6dp">

        <Button android:id="@+id/btn1"
            android:layout_columnWeight="1" android:layout_width="0dp"
            android:text="1" android:textSize="18sp" android:padding="4dp"
            android:textColor="#000000" android:background="#E0E0E0" />
        <Button android:id="@+id/btn2"
            android:layout_columnWeight="1" android:layout_width="0dp"
            android:text="2" android:textSize="18sp" android:padding="4dp"
            android:textColor="#000000" android:background="#E0E0E0" />
        <Button android:id="@+id/btn3"
            android:layout_columnWeight="1" android:layout_width="0dp"
            android:text="3" android:textSize="18sp" android:padding="4dp"
            android:textColor="#000000" android:background="#E0E0E0" />
        <Button android:id="@+id/btn4"
            android:layout_columnWeight="1" android:layout_width="0dp"
            android:text="4" android:textSize="18sp" android:padding="4dp"
            android:textColor="#000000" android:background="#E0E0E0" />
        <Button android:id="@+id/btn5"
            android:layout_columnWeight="1" android:layout_width="0dp"
            android:text="5" android:textSize="18sp" android:padding="4dp"
            android:textColor="#000000" android:background="#E0E0E0" />
        <Button android:id="@+id/btn6"
            android:layout_columnWeight="1" android:layout_width="0dp"
            android:text="6" android:textSize="18sp" android:padding="4dp"
            android:textColor="#000000" android:background="#E0E0E0" />
        <Button android:id="@+id/btn7"
            android:layout_columnWeight="1" android:layout_width="0dp"
            android:text="7" android:textSize="18sp" android:padding="4dp"
            android:textColor="#000000" android:background="#E0E0E0" />
        <Button android:id="@+id/btn8"
            android:layout_columnWeight="1" android:layout_width="0dp"
            android:text="8" android:textSize="18sp" android:padding="4dp"
            android:textColor="#000000" android:background="#E0E0E0" />
        <Button android:id="@+id/btn9"
            android:layout_columnWeight="1" android:layout_width="0dp"
            android:text="9" android:textSize="18sp" android:padding="4dp"
            android:textColor="#000000" android:background="#E0E0E0" />
    </GridLayout>

    <!-- Clear + New game row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✕ Clear" />

        <Button
            android:id="@+id/newGameButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="New game" />
    </LinearLayout>

    <!-- Difficulty selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btnEasy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Easy"
            android:textColor="#000000"
            android:background="#E0E0E0" />

        <Button
            android:id="@+id/btnMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Medium"
            android:textColor="#000000"
            android:background="#E0E0E0" />

        <Button
            android:id="@+id/btnHard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hard"
            android:textColor="#000000"
            android:background="#E0E0E0" />
    </LinearLayout>

</LinearLayout>
